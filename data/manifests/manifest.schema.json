{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/h-yamani/MaintMind/data/manifests/manifest.schema.json",
  "title": "MaintMind Dataset Ingestion Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_group",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_group": {
      "type": "string",
      "minLength": 1
    },
    "allowed_join": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "original_filename",
          "local_path",
          "source_url",
          "retrieved_at",
          "file_size_bytes",
          "sha256",
          "raw_file_committed_to_git"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "original_filename": {
            "type": "string",
            "minLength": 1
          },
          "local_path": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "file_size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "raw_file_committed_to_git": {
            "type": "boolean"
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
